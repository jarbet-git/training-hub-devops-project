@baseUrl = http://127.0.0.1:8000

########################################################
# USTAW RĘCZNIE po CREATE / ADD-ITEM (z odpowiedzi JSON)
########################################################
@formId = 0
@itemId = 0

########################################################
# TOKENY (wklej po loginie, każdy osobno!)
########################################################
@token_user = PASTE_USER_TOKEN_HERE
@token_manager = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI0IiwidHlwZSI6ImFjY2VzcyIsImV4cCI6MTc2OTY4MzMyNn0.oASqxkJFACk314ZHR09S7obmfr4dC-FGfQ0QpDL5FKU
@token_hr = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI1IiwidHlwZSI6ImFjY2VzcyIsImV4cCI6MTc2OTY4MzQwN30.KL6r5j2VDR0tyKQQnR5GduwZZOm0Q3L8J4lpn80XqGM
@token_admin = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzIiwidHlwZSI6ImFjY2VzcyIsImV4cCI6MTc2OTY4MzM2N30._W2AxMj81OQn5Pb0Dh4LGGHevuDiBVqQYBoU_pKZmeo


### HEALTH
GET {{baseUrl}}/health


#############################################
# AUTH / USERS
#############################################

### REGISTER USER (EDITOR) - opcjonalnie (użyj normalnego maila, np. example.com)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test1@example.com",
  "full_name": "Test User",
  "password": "Test1234!"
}

### LOGIN USER (EDITOR)
# -> skopiuj access_token do @token_user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test1@example.com",
  "password": "Test1234!"
}

### LOGIN MANAGER
# -> skopiuj access_token do @token_manager
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "manager@poap.example.com",
  "password": "Manager1234!"
}

### LOGIN HR
# -> skopiuj access_token do @token_hr
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "hr@poap.example.com",
  "password": "HR1234!"
}

### LOGIN ADMIN
# -> skopiuj access_token do @token_admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@poap.example.com",
  "password": "Admin1234!Admin123"
}


### ME (USER)
GET {{baseUrl}}/users/me
Authorization: Bearer {{token_user}}

### ME (MANAGER)
GET {{baseUrl}}/users/me
Authorization: Bearer {{token_manager}}

### ME (HR)
GET {{baseUrl}}/users/me
Authorization: Bearer {{token_hr}}

### ME (ADMIN)
GET {{baseUrl}}/users/me
Authorization: Bearer {{token_admin}}


#############################################
# ADMIN USERS (ADMIN)
# (zadziała jeśli wdrożyłeś /admin/users: list/patch/reset-password)
#############################################

### ADMIN - LIST USERS
GET {{baseUrl}}/admin/users?limit=50&offset=0
Authorization: Bearer {{token_admin}}

### ADMIN - SEARCH USERS (q)
GET {{baseUrl}}/admin/users?q=poap&limit=50&offset=0
Authorization: Bearer {{token_admin}}

### ADMIN - FILTER BY ROLE
GET {{baseUrl}}/admin/users?role=HR&limit=50&offset=0
Authorization: Bearer {{token_admin}}

### ADMIN - UPDATE USER (podmień userId)
PATCH {{baseUrl}}/admin/users/1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "role": "MANAGER",
  "is_active": true
}

### ADMIN - RESET PASSWORD (podmień userId)
POST {{baseUrl}}/admin/users/1/reset-password
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "new_password": "NewPass1234!"
}


#############################################
# PUBLIC DICT (read-only)
#############################################

### DICT - AREAS
GET {{baseUrl}}/dict/areas
Authorization: Bearer {{token_user}}

### DICT - COST CENTERS for area_id=1
GET {{baseUrl}}/dict/areas/1/cost-centers
Authorization: Bearer {{token_user}}

### DICT - CATEGORIES
GET {{baseUrl}}/dict/categories
Authorization: Bearer {{token_user}}

### DICT - TRAININGS for category_id=1
GET {{baseUrl}}/dict/categories/1/trainings
Authorization: Bearer {{token_user}}

### DICT - BUSINESS NEEDS
GET {{baseUrl}}/dict/business-needs
Authorization: Bearer {{token_user}}


#############################################
# FORMS (USER FLOW)
#############################################

### FORMS - CREATE (USER)
# -> skopiuj z odpowiedzi "id" do @formId
POST {{baseUrl}}/forms
Authorization: Bearer {{token_user}}
Content-Type: application/json

{
  "area_id": 1,
  "cost_center_id": 1
}

### FORMS - ADD ITEM (USER)
# -> skopiuj z odpowiedzi "id" do @itemId
POST {{baseUrl}}/forms/{{formId}}/items
Authorization: Bearer {{token_user}}
Content-Type: application/json

{
  "training_category_id": 1,
  "training_name_id": 1,
  "priority": "MEDIUM",
  "quarter": "Q1",
  "business_need_id": 1,
  "employees_count": 3,
  "employee_full_name": "Jan Kowalski",
  "estimated_cost_per_person": 1000,
  "estimated_hours_per_person": 8,
  "contact_person": "Jan Kowalski",
  "notes": "Test"
}

### FORMS - DETAILS (USER)
GET {{baseUrl}}/forms/{{formId}}
Authorization: Bearer {{token_user}}

### FORMS - MY (USER)
GET {{baseUrl}}/forms/my
Authorization: Bearer {{token_user}}

### FORMS - PATCH ITEM (USER, częściowo)
PATCH {{baseUrl}}/forms/{{formId}}/items/{{itemId}}
Authorization: Bearer {{token_user}}
Content-Type: application/json

{
  "employees_count": 5,
  "notes": "Zmienione"
}

### FORMS - PATCH ITEM (USER, wymuś błąd: training_name_id nie pasuje do category_id)
PATCH {{baseUrl}}/forms/{{formId}}/items/{{itemId}}
Authorization: Bearer {{token_user}}
Content-Type: application/json

{
  "training_category_id": 1,
  "training_name_id": 3
}

### FORMS - DELETE ITEM (USER)
DELETE {{baseUrl}}/forms/{{formId}}/items/{{itemId}}
Authorization: Bearer {{token_user}}

### FORMS - SUBMIT (USER) => MANAGER_REVIEW
POST {{baseUrl}}/forms/{{formId}}/submit
Authorization: Bearer {{token_user}}


#############################################
# MANAGER FLOW
#############################################

### MANAGER INBOX
GET {{baseUrl}}/forms/manager/inbox
Authorization: Bearer {{token_manager}}

### MANAGER - REQUEST CHANGES => REPLIED
POST {{baseUrl}}/forms/{{formId}}/manager/request-changes
Authorization: Bearer {{token_manager}}
Content-Type: application/json

{
  "comment": "Proszę poprawić opis i koszty."
}

### USER - RESUBMIT (tylko gdy status=REPLIED) => MANAGER_REVIEW
POST {{baseUrl}}/forms/{{formId}}/resubmit
Authorization: Bearer {{token_user}}

### MANAGER - APPROVE => HR_REVIEW
POST {{baseUrl}}/forms/{{formId}}/manager/approve
Authorization: Bearer {{token_manager}}


#############################################
# HR FLOW
#############################################

### HR INBOX
GET {{baseUrl}}/forms/hr/inbox
Authorization: Bearer {{token_hr}}

### HR - REQUEST CHANGES => REPLIED (wraca do autora)
POST {{baseUrl}}/forms/{{formId}}/hr/request-changes
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "comment": "Brakuje uzasadnienia biznesowego."
}

### HR - SET ITEM BUDGET
PATCH {{baseUrl}}/forms/{{formId}}/items/{{itemId}}/hr-budget
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "hr_budget_total": 15000
}

### HR - CLOSE => CLOSED
POST {{baseUrl}}/forms/{{formId}}/hr/close
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "comment": "Zamykam wniosek."
}


#############################################
# ADMIN/HR - DICT CRUD (admin panel)
#############################################

### ADMIN/HR - CREATE AREA
POST {{baseUrl}}/admin/dict/areas
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "code": "PL_TEST",
  "name_pl": "Testowy obszar",
  "name_en": "Test area"
}

### ADMIN/HR - PATCH AREA
PATCH {{baseUrl}}/admin/dict/areas/1
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "name_pl": "AFC (PL) - zmiana"
}

### ADMIN/HR - CREATE COST CENTER (dla area_id=1)
POST {{baseUrl}}/admin/dict/areas/1/cost-centers
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "code": "PHP99999",
  "name_pl": "MPK test",
  "name_en": "Test cost center"
}

### ADMIN/HR - CREATE CATEGORY
POST {{baseUrl}}/admin/dict/categories
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "name_pl": "Nowa kategoria",
  "name_en": "New category"
}

### ADMIN/HR - CREATE TRAINING (podmień category_id)
POST {{baseUrl}}/admin/dict/categories/1/trainings
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "name_pl": "Nowe szkolenie",
  "name_en": "New training"
}

### ADMIN/HR - CREATE BUSINESS NEED
POST {{baseUrl}}/admin/dict/business-needs
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "name_pl": "Nowa potrzeba",
  "name_en": "New need"
}
### FORMS - HISTORY (USER / MANAGER / HR / ADMIN - zależy kto ma dostęp)
GET {{baseUrl}}/forms/{{formId}}/history?limit=100&offset=0
Authorization: Bearer {{token_user}}
#############################################
# COLLECTION WINDOW
#############################################

### UI - GET window
GET {{baseUrl}}/collection-window

### ADMIN/HR - GET window
GET {{baseUrl}}/admin/collection-window
Authorization: Bearer {{token_hr}}

### ADMIN/HR - CLOSE collection
PATCH {{baseUrl}}/admin/collection-window
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "is_open": false
}

### ADMIN/HR - OPEN collection
PATCH {{baseUrl}}/admin/collection-window
Authorization: Bearer {{token_hr}}
Content-Type: application/json

{
  "is_open": true
}

#############################################
# EXPORT (HR/ADMIN)
#############################################

### EXPORT CSV
GET {{baseUrl}}/admin/reports/forms-export?format=csv
Authorization: Bearer {{token_hr}}

### EXPORT XLSX
GET {{baseUrl}}/admin/reports/forms-export?format=xlsx
Authorization: Bearer {{token_hr}}

### EXPORT XLSX filtered
GET {{baseUrl}}/admin/reports/forms-export?format=xlsx&status_value=HR_REVIEW&area_id=1
Authorization: Bearer {{token_hr}}
